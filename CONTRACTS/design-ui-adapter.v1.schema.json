{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TAKY_DESIGN_UI_ADAPTER_V1",
  "title": "TAKY Design UI Adapter V1",
  "type": "object",
  "required": ["schema", "capture", "checks"],
  "properties": {
    "schema": {"const": "TAKY_DESIGN_UI_ADAPTER_V1"},
    "capture": {
      "type": "object",
      "required": ["command", "artifacts"],
      "properties": {
        "command": {"$ref": "#/$defs/argv"},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["screen_id", "state_id", "viewport_id", "path"],
            "properties": {
              "screen_id": {"type": "string", "minLength": 1},
              "state_id": {"type": "string", "minLength": 1},
              "viewport_id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": ["interaction", "responsive", "asset_integrity"],
      "properties": {
        "interaction": {"$ref": "#/$defs/check"},
        "responsive": {"$ref": "#/$defs/check"},
        "asset_integrity": {"$ref": "#/$defs/check"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "check": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": {"$ref": "#/$defs/argv"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
