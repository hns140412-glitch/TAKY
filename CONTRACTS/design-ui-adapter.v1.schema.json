{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TAKY_DESIGN_UI_ADAPTER_V1",
  "title": "TAKY Design UI Adapter V1",
  "type": "object",
  "required": ["schema", "commands", "outputs"],
  "properties": {
    "schema": {"const": "TAKY_DESIGN_UI_ADAPTER_V1"},
    "commands": {
      "type": "object",
      "required": ["capture", "interaction", "responsive", "asset_integrity"],
      "properties": {
        "capture": {"$ref": "#/$defs/argv"},
        "interaction": {"$ref": "#/$defs/argv"},
        "responsive": {"$ref": "#/$defs/argv"},
        "asset_integrity": {"$ref": "#/$defs/argv"}
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": ["render_manifest", "interaction", "responsive", "asset_integrity"],
      "properties": {
        "render_manifest": {"const": "ui-audit/render-manifest.json"},
        "interaction": {"const": "ui-audit/interaction-result.json"},
        "responsive": {"const": "ui-audit/responsive-result.json"},
        "asset_integrity": {"const": "ui-audit/asset-result.json"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
