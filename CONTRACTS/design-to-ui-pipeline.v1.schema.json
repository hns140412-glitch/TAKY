{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TAKY_DESIGN_TO_UI_PIPELINE_V1",
  "title": "TAKY Design-to-UI Pipeline V1",
  "type": "object",
  "required": ["schema", "project", "source_commit", "policy", "screens"],
  "properties": {
    "schema": {"const": "TAKY_DESIGN_TO_UI_PIPELINE_V1"},
    "project": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "policy": {
      "type": "object",
      "required": [
        "runtime_must_not_auto_become_golden",
        "flattened_mockup_runtime_forbidden",
        "evidence_files_required",
        "image_generation_optional"
      ],
      "properties": {
        "runtime_must_not_auto_become_golden": {"const": true},
        "flattened_mockup_runtime_forbidden": {"const": true},
        "evidence_files_required": {"const": true},
        "image_generation_optional": {"const": true}
      },
      "additionalProperties": true
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "authority_ref", "golden", "screen_contract",
          "layer_contract", "viewports", "states"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "authority_ref": {"type": "string", "minLength": 1},
          "golden": {
            "type": "object",
            "required": ["status", "path", "sha256", "use", "source_receipt"],
            "properties": {
              "status": {"enum": ["BOUND", "IMPORT_OPEN"]},
              "source_receipt": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
              "use": {"const": "REFERENCE_ONLY"}
            }
          },
          "screen_contract": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
            }
          },
          "layer_contract": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
            }
          },
          "viewports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "width", "height", "dpr"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "width": {"type": "integer", "minimum": 240},
                "height": {"type": "integer", "minimum": 320},
                "dpr": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "fixture_path", "fixture_sha256"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "fixture_path": {"type": "string", "minLength": 1},
                "fixture_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
                "visual_policy": {"enum": ["GOLDEN_PARITY", "LAYOUT_GUARD", "NO_VISUAL_EVIDENCE"]}
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
