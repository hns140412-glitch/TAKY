{
  "schema": "TAKY_BADGE_CLI_EXECUTOR_ADAPTER_CONTRACT_V1",
  "status": "CONTRACT_ONLY_NO_PROVIDER_BOUND",
  "provider": null,
  "generation_enabled": false,
  "resource_policy": {
