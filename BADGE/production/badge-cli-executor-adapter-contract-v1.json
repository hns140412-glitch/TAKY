      120,
      200,
      320
    ],
    "generator_must_return_receipt": true,
    "provider_limit_is_external_and_not_assumed": true
  },
  "fail_closed": [
    "NO_PROVIDER_BOUND",
    "NO_QUOTA_STATUS_SIGNAL",
    "NO_OUTPUT_RECEIPT",
    "OUTPUT_CONTRACT_FAIL",
    "SOURCE_SHA_DRIFT",
    "CHECKPOINT_HASH_DRIFT"
