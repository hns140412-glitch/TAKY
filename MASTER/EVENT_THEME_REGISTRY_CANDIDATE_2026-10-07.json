{
  "schema_version": "TAKY_EVENT_THEME_REGISTRY_V0_CANDIDATE",
  "status": "CANDIDATE_NOT_PROMOTED",
  "rule_id": "TKY-EVENT-THEME-001",
  "invariant": "EVENT_MAY_DECORATE_BUT_MUST_NOT_REWRITE_EXPERIENCE",
  "max_global_themes": 1,
  "max_personal_overlays": 1,
