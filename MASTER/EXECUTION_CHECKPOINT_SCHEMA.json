{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TAKY Atomic Current Checkpoint",
  "type": "object",
  "required": [
    "checkpoint_version",
    "task_id",
    "namespace",
    "atomic_unit",
    "status",
    "done",
    "open",
    "next",
    "corrections",
    "source_refs",
    "updated_at"
  ],
  "properties": {
    "checkpoint_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "namespace": {"type": "string", "minLength": 1},
    "atomic_unit": {"type": "string", "minLength": 1},
    "status": {"enum": ["RUNNING", "BLOCKED", "COMPLETE"]},
    "done": {"type": "array", "items": {"type": "string"}},
    "open": {"type": "array", "items": {"type": "string"}},
    "next": {"type": ["string", "null"]},
    "corrections": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "updated_at": {"type": "string", "format": "date-time"},
    "parent_checkpoint": {"type": ["string", "null"]},
    "input_refs": {"type": "array", "items": {"type": "string"}},
    "input_hashes": {"type": "array", "items": {"type": "string"}},
    "output_refs": {"type": "array", "items": {"type": "string"}},
    "output_hashes": {"type": "array", "items": {"type": "string"}},
    "contract_version": {"type": ["string", "null"]},
    "checks": {"type": "array", "items": {"type": "string"}},
    "failure_class": {"type": ["string", "null"]},
    "next_route": {"type": ["string", "null"]},
    "rollback": {"type": ["string", "null"]},
    "approval_scope": {"type": ["string", "null"]},
    "side_effect_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "approval_binding": {
      "type": "object",
      "required": ["action_kind", "action_payload_hash"],
      "properties": {
        "action_kind": {"type": "string", "minLength": 1},
        "action_payload_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "additionalProperties": true
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
