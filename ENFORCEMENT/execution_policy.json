{
  "policy_id": "TAKY_EXECUTION_ENFORCEMENT_REV_01",
  "fail_closed": true,
  "required_preflight_fields": [
    "task_id","scope","applicable_rules_loaded","known_context_checked","role","route","execution_owner","action_class","validation_owner","user_role","historical_failure_classes_checked"
  ],
  "roles": {
    "TAKY": "ORCHESTRATOR",
    "USER": "PRODUCT_OWNER_FINAL_APPROVER",
    "CI": "VALIDATOR"
  },
  "blocking_rules": [
    {
      "id": "E-ROLE-001",
      "when": {"role":"ORCHESTRATOR","action_class":"IMPLEMENTATION_WRITE"},
      "unless": {"execution_owner":"TAKY"},
      "decision":"BLOCK",
      "failure_class":"ROLE_OWNER_VIOLATION"
    },
    {
      "id": "E-CONTEXT-001",
      "when": {"known_context_checked":false},
      "decision":"BLOCK",
      "failure_class":"KNOWN_CONTEXT_OMISSION_RISK"
    },
    {
      "id": "E-HISTORY-001",
      "when": {"historical_failure_classes_checked":false},
      "decision":"BLOCK",
      "failure_class":"HISTORY_NOT_ACTIVATED"
    },
    {
      "id": "E-PROGRESS-001",
      "when": {"action_class":"VALIDATION_ONLY"},
      "decision":"NO_PRODUCT_PROGRESS_ADVANCE",
      "failure_class":"VALIDATION_AS_PRODUCT_PROGRESS"
    }
  ],
  "repeat_failure_classes": [
    "REPEAT_FAILURE","ENFORCEMENT_GAP","POST_CORRECTION_REOCCURRENCE","REGRESSION_FAIL"
  ],
  "status_ladder": ["INTENDED","ATTEMPTED","WRITTEN","SAVED","VERIFIED","IMPLEMENTED","DEPLOYED","RELEASE_PASS"],
  "mandatory_regression_cases": ["R-2026-09-14-READYSET-ORCHESTRATOR-DRIFT"]
}
