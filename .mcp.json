{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.83"
      ],
      "env": {}
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "chrome-devtools-mcp@1.10.1"
      ],
      "env": {}
    },
    "netlify": {
      "type": "http",
      "url": "https://netlify-mcp.netlify.app/mcp"
    },
    "scenario": {
      "type": "http",
      "url": "https://mcp.scenario.com/mcp"
    }
  }
}